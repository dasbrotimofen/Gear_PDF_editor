<Window x:Class="GearPdf.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:GearPdf.App" Title="GEAR PDF Editor" Width="1280" Height="900" Background="#101923" Foreground="#F1F5FA" Closing="OnClosing" KeyDown="OnKeyDown"><DockPanel><WrapPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="10"><TextBlock Text="GEAR PDF Editor" FontSize="22" FontWeight="Bold" VerticalAlignment="Center" Margin="5,0,22,0"/><Button Content="New" Click="NewClick"/><Button Content="Open .gear" Click="OpenClick"/><Button Content="Import PDF" Click="ImportPdfClick"/><Button Content="Export PDF" Click="ExportPdfClick"/><Button Content="Paste image" Click="PasteImageClick"/><Button Content="Save" Click="SaveClick"/><Button Content="Save As" Click="SaveAsClick"/><Button Content="Undo" Click="UndoClick"/><Button Content="Redo" Click="RedoClick"/><Button Content="Fit page" Click="FitClick"/></WrapPanel><TextBlock x:Name="Status" DockPanel.Dock="Bottom" Margin="16,8"/><StackPanel DockPanel.Dock="Left" Width="175" Margin="10"><TextBlock Text="PAPER" Margin="7,10"/><ComboBox x:Name="PaperSize" Foreground="#182333" SelectedIndex="0" SelectionChanged="PaperChanged"><ComboBoxItem Content="A4 portrait"/><ComboBoxItem Content="A4 landscape"/><ComboBoxItem Content="A3 portrait"/><ComboBoxItem Content="A3 landscape"/><ComboBoxItem Content="Letter portrait"/></ComboBox><TextBlock Text="5 mm grid visibility" Margin="7,14,0,3"/><Slider x:Name="GridOpacity" Minimum="0" Maximum="100" Value="25" ValueChanged="GridChanged"/><TextBlock Text="PAGES" Margin="7,16,0,5"/><ListBox x:Name="PagesList" Height="130" Foreground="#182333" SelectionChanged="PageSelected"/>
<WrapPanel><Button Content="Add" Click="AddPageClick"/><Button x:Name="DeletePageButton" Content="Delete" Click="DeletePageClick"/></WrapPanel>
<WrapPanel><Button Content="Move ↑" Click="PageUpClick"/><Button Content="Move ↓" Click="PageDownClick"/></WrapPanel><StackPanel Orientation="Horizontal"><Button Content="←" Click="PreviousClick"/><Button Content="→" Click="NextClick"/><TextBlock x:Name="PageLabel" VerticalAlignment="Center"/></StackPanel><TextBlock Text="Finger: pan / pinch
Ctrl + wheel: zoom
Middle drag: pan" TextWrapping="Wrap" Margin="7,25,0,0"/></StackPanel><DockPanel DockPanel.Dock="Right" Width="245" Margin="8"><StackPanel DockPanel.Dock="Top"><TextBlock Text="PAGE REFERENCE" FontWeight="Bold" Margin="5,10"/><ComboBox x:Name="ReferencePage" Foreground="#182333" SelectionChanged="ReferencePageSelected"/><local:SketchCanvas x:Name="ReferenceSurface" Height="260" Margin="0,6" IsHitTestVisible="False" Focusable="False" SizeChanged="ReferenceSizeChanged"/><Button Content="Enlarge reference" Click="EnlargeReferenceClick"/></StackPanel><TextBlock DockPanel.Dock="Top" Text="LAYERS · front to back" FontWeight="Bold" Margin="5,10"/>
<StackPanel DockPanel.Dock="Bottom"><WrapPanel><Button Content="Forward" Click="LayerForwardClick"/><Button Content="Backward" Click="LayerBackwardClick"/></WrapPanel><WrapPanel><Button Content="To front" Click="LayerFrontClick"/><Button Content="To back" Click="LayerBackClick"/></WrapPanel><Button Content="Lock all images" Click="LockImagesClick"/><TextBlock Text="Images and strokes have separate tabs. Locked layers cannot be erased or edited. Ordering applies across both tabs. PDF page backgrounds stay fixed." TextWrapping="Wrap" Margin="5,8"/></StackPanel>
<TabControl SelectedIndex="0" Background="#101923" BorderBrush="#60758D" Padding="0"><TabItem Header="Images" Foreground="#182333"><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel x:Name="ImageLayerRows" TextElement.Foreground="#F1F5FA"/></ScrollViewer></TabItem><TabItem Header="Strokes" Foreground="#182333"><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel x:Name="StrokeLayerRows" TextElement.Foreground="#F1F5FA"/></ScrollViewer></TabItem></TabControl></DockPanel><Grid><local:SketchCanvas x:Name="Surface"/><Canvas x:Name="GearHost" SizeChanged="GearHostSizeChanged" ClipToBounds="True"><Canvas x:Name="Gear" Width="660" Height="660"/>
<Border x:Name="FavouriteBar" Background="#202D3E" BorderBrush="#60758D" BorderThickness="1" CornerRadius="8" Padding="6" SizeChanged="FavouriteBarSizeChanged">
<StackPanel>
 <DockPanel>
  <Button x:Name="FavouriteOrientation" DockPanel.Dock="Right" Content="↔" Padding="7,4" Click="FavouriteOrientationClick"/>
  <Border x:Name="FavouriteHandle" Background="Transparent" Padding="5,7" Cursor="SizeAll" ToolTip="Drag to move favourites"
   MouseLeftButtonDown="FavouriteHandleMouseDown" MouseMove="FavouriteHandleMouseMove" MouseLeftButtonUp="FavouriteHandleMouseUp" LostMouseCapture="FavouriteHandleLostMouseCapture"
   TouchDown="FavouriteHandleTouchDown" TouchMove="FavouriteHandleTouchMove" TouchUp="FavouriteHandleTouchUp" LostTouchCapture="FavouriteHandleLostTouchCapture">
   <TextBlock Text="⠿ Favourites" FontWeight="SemiBold"/>
  </Border>
 </DockPanel>
 <ScrollViewer MaxWidth="600" MaxHeight="380" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"><StackPanel x:Name="Favourites"/></ScrollViewer>
</StackPanel>
</Border></Canvas></Grid></DockPanel></Window>